{
  "name": "soundline-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Soundline — a framework-free audio player core with a React binding",
  "packageManager": "pnpm@9.8.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @nickkupriyanov/soundline-core build && pnpm --filter @nickkupriyanov/soundline-react build",
    "dev": "pnpm --filter @nickkupriyanov/soundline-playground dev",
    "preview": "pnpm --filter @nickkupriyanov/soundline-playground preview",
    "storybook": "pnpm --filter @nickkupriyanov/soundline-react storybook",
    "build-storybook": "pnpm --filter @nickkupriyanov/soundline-react build-storybook",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @nickkupriyanov/soundline-react test:watch",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "screenshot": "node tools/screenshot.mjs",
    "check:layout": "node tools/check-layout.mjs",
    "check:container": "node tools/check-container.mjs",
    "check:hydration": "node tools/check-hydration.mjs --dir .verify/react-19/dist --scope #root",
    "verify:install": "node tools/verify-install.mjs",
    "verify:install:leg": "node tools/verify-install.mjs --leg"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
